# ── Strava OAuth ─────────────────────────────────────────────────────────────
# Create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Token used to verify the webhook subscription with Strava (pick any secret string)
STRAVA_VERIFY_TOKEN=strideiq_verify

# Populated automatically after completing the OAuth flow (/auth/strava)
STRAVA_REFRESH_TOKEN=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Find your Account ID at: Cloudflare Dashboard → R2 → Overview
R2_ACCOUNT_ID=89dfb1dc7856ed01f3a90d6e44717274

# Create an API token at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Requires: Object Read & Write permissions on the strideiq-raw bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_BUCKET_NAME=strideiq-raw

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL where this service is reachable (used for OAuth callback + webhook)
# For local dev: use `ngrok http 8000` and set the ngrok URL here
APP_BASE_URL=https://your-domain.com
